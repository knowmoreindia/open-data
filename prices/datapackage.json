            "type": [
              "string",
              "null"
            ],
            "description": "Rural, Urban or Combined"
          },
          {
            "name": "group",
            "type": [
              "string",
              "null"
            ],
            "description": "Group, such as Food and beverages, or General"
          },
          {
            "name": "subgroup",
            "type": [
              "string",
              "null"
            ],
            "description": "Subgroup, such as Cereals and products, or General-Overall for the headline index"
          },
          {
            "name": "index",
            "type": [
              "number",
              "null"
